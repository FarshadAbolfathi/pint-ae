{
  "name": "pint-ae-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Open-source TypeScript SDK and CLI for building and validating UAE PINT AE e-invoices.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --build --force",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "clean": "pnpm -r exec rm -rf dist .tsbuildinfo && rm -rf coverage"
  },
  "devDependencies": {
    "@changesets/cli": "2.27.11",
    "@eslint/js": "9.17.0",
    "@pint-ae/adapter-mock": "workspace:*",
    "@pint-ae/ae": "workspace:*",
    "@types/node": "22.10.5",
    "@typescript-eslint/eslint-plugin": "8.19.1",
    "@typescript-eslint/parser": "8.19.1",
    "@vitest/coverage-v8": "2.1.8",
    "eslint": "9.17.0",
    "eslint-config-prettier": "9.1.0",
    "prettier": "3.4.2",
    "tsup": "8.3.5",
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  }
}
