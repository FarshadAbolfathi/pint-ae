{
  "name": "@pint-ae/core",
  "version": "0.1.0",
  "description": "Generic Peppol PINT domain model, money/rounding utilities, validation engine and ASP adapter interfaces.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {
    "decimal.js": "10.4.3",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "tsup": "8.3.5",
    "typescript": "5.7.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
