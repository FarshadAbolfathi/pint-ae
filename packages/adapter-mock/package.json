{
  "name": "@pint-ae/adapter-mock",
  "version": "0.1.0",
  "description": "A mock Accredited Service Provider (ASP) adapter for the pint-ae SDK, for testing and examples.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {
    "@pint-ae/core": "workspace:*"
  },
  "devDependencies": {
    "tsup": "8.3.5",
    "typescript": "5.7.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
