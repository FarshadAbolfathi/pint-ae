{
  "name": "@pint-ae/ae",
  "version": "0.1.0",
  "description": "UAE profile for Peppol PINT: TRN validation, VAT categories, PINT AE business rules, builder and UBL serialisation.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {
    "@pint-ae/core": "workspace:*",
    "fast-xml-parser": "4.5.1",
    "xmlbuilder2": "3.1.1",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "tsup": "8.3.5",
    "typescript": "5.7.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
